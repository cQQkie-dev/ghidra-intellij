<idea-plugin>
    <id>com.codingmates.ghidra</id>
    <name>Ghidra</name>
    <vendor email="gary.tierney@fastmail.com" url="https://github.com/garyttierney/intellij-ghidra">Gary Tierney</vendor>

    <description><![CDATA[Support for editing Ghidra extensions in IntelliJ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Ghidra" displayType="BALLOON" />
        <configurationType implementation="com.codingmates.ghidra.intellij.ide.runConfiguration.GhidraLauncherConfigurationType"/>
        <programRunner id="Run" implementation="com.codingmates.ghidra.intellij.ide.runConfiguration.GhidraLauncherRunner"/>
        <programRunner id="Debug" implementation="com.codingmates.ghidra.intellij.ide.runConfiguration.GhidraLauncherDebugRunner"/>
        <facetType implementation="com.codingmates.ghidra.intellij.ide.facet.GhidraFacetType" />
        <applicationConfigurable
                parentId="tools"
                instance="com.codingmates.ghidra.intellij.ide.installation.GhidraInstallationsConfigurable"
                displayName="Ghidra Installations" />
    </extensions>

    <actions>
        <action
                id="com.codingmates.ghidra.intellij.CreateGhidraExtensionProject"
                class="com.codingmates.ghidra.intellij.ide.action.CreateGhidraExtensionProjectAction"
                text="New Ghidra Extension Project"
                description="Create a Gradle-backed Ghidra extension project">
            <add-to-group group-id="ToolsMenu" anchor="first" />
        </action>
        <action
                id="com.codingmates.ghidra.intellij.CreateGhidraScriptProject"
                class="com.codingmates.ghidra.intellij.ide.action.CreateGhidraScriptProjectAction"
                text="New Ghidra Script Project"
                description="Create a Gradle-backed Ghidra script project">
            <add-to-group group-id="ToolsMenu" anchor="first" />
        </action>
        <action
                id="com.codingmates.ghidra.intellij.CreateGhidraScript"
                class="com.codingmates.ghidra.intellij.ide.action.CreateGhidraScriptAction"
                text="New Ghidra Script"
                description="Create a new Java or Python Ghidra script">
            <add-to-group group-id="ToolsMenu" anchor="first" />
        </action>
        <action
                id="com.codingmates.ghidra.intellij.GenerateGhidraGradleWrapper"
                class="com.codingmates.ghidra.intellij.ide.action.GenerateGhidraGradleWrapperAction"
                text="Generate Ghidra Gradle Wrapper"
                description="Generate a Gradle Wrapper for the current Ghidra project">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
        <action
                id="com.codingmates.ghidra.intellij.DistributeGhidraExtension"
                class="com.codingmates.ghidra.intellij.ide.action.DistributeGhidraExtensionAction"
                text="Distribute Ghidra Extension"
                description="Build and package the current Ghidra extension">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
            <action
                id="com.codingmates.ghidra.intellij.InstallGhidraExtension"
                class="com.codingmates.ghidra.intellij.ide.action.InstallGhidraExtensionAction"
                text="Install Latest Ghidra Extension"
                description="Install the newest built Ghidra extension archive">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>